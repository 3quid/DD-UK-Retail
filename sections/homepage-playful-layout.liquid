{{ 'section-homepage-playful-layout.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign layout_mode = section.settings.layout_mode
  assign aspect_desktop = section.settings.aspect_ratio
  assign aspect_mobile = section.settings.aspect_ratio_mobile

  case aspect_desktop
    when '3 / 1'
      assign playful_aspect = '3'
    when '5 / 2'
      assign playful_aspect = '2.5'
    when '2 / 1'
      assign playful_aspect = '2'
    when '16 / 9'
      assign playful_aspect = '1.7777778'
    when '4 / 3'
      assign playful_aspect = '1.3333333'
    when '1 / 1'
      assign playful_aspect = '1'
    else
      assign playful_aspect = 'auto'
  endcase

  if aspect_mobile == 'same'
    assign playful_aspect_mobile = playful_aspect
  else
    case aspect_mobile
      when '3 / 1'
        assign playful_aspect_mobile = '3'
      when '5 / 2'
        assign playful_aspect_mobile = '2.5'
      when '2 / 1'
        assign playful_aspect_mobile = '2'
      when '16 / 9'
        assign playful_aspect_mobile = '1.7777778'
      when '4 / 3'
        assign playful_aspect_mobile = '1.3333333'
      when '3 / 2'
        assign playful_aspect_mobile = '1.5'
      when '1 / 1'
        assign playful_aspect_mobile = '1'
      else
        assign playful_aspect_mobile = 'auto'
    endcase
  endif

  assign min_height = section.settings.min_height
  assign min_height_mobile = section.settings.min_height_mobile
  if min_height > 0
    assign min_height_css = min_height | append: 'px'
  else
    assign min_height_css = 'auto'
  endif
  if min_height_mobile > 0
    assign min_height_mobile_css = min_height_mobile | append: 'px'
  else
    assign min_height_mobile_css = min_height_css
  endif
-%}

<div
  id="section-{{ section.id }}"
  class="container--fullwidth {% unless section.settings.remove_margin %} container--vertical-space {% endunless %} {% if section.settings.section_background_color != 'rgba(0,0,0,0)' or section.settings.section_background_gradient != blank %} container--has-background {% endif %} remove-empty-space"
>
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="container--large">
      {%- render 'section-heading', heading: section.settings.heading, subheading: section.settings.subheading, heading_tag: section.settings.seo_h_tag, layout: section.settings.section_heading_layout -%}
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    {%- style -%}
      #section-{{ section.id }} .playful-layout__scene {
        --playful-aspect: {{ playful_aspect }};
        --playful-aspect-mobile: {{ playful_aspect_mobile }};
        --playful-min-height: {{ min_height_css }};
        --playful-min-height-mobile: {{ min_height_mobile_css }};
        --playful-stack-gap: {{ section.settings.stack_gap }}px;
        --playful-section-padding-y: {{ section.settings.section_padding_y }}px;
      }
      {%- for block in section.blocks -%}
        {%- if block.type == 'background' and block.settings.overlay_opacity > 0 -%}
          #playful-bg-{{ block.id }} {
            --playful-bg-overlay: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
          }
        {%- endif -%}
        {%- if block.type == 'floating_image' -%}
          #playful-float-{{ block.id }} {
            --playful-offset-x: {{ block.settings.horizontal_offset }}%;
            --playful-offset-y: {{ block.settings.vertical_offset }}%;
            --playful-offset-x-mobile: {{ block.settings.horizontal_offset_mobile }}%;
            --playful-offset-y-mobile: {{ block.settings.vertical_offset_mobile }}%;
            --playful-size: {{ block.settings.size_desktop }}%;
            --playful-size-mobile: {{ block.settings.size_mobile }}%;
            --playful-rotate: {{ block.settings.rotation_desktop }}deg;
            --playful-rotate-mobile: {{ block.settings.rotation_mobile }}deg;
            --playful-z: {{ block.settings.z_index }};
            --playful-animation-duration: {{ block.settings.animation_duration }}s;
            --playful-animation-delay: {{ block.settings.animation_delay }}s;
          }
        {%- endif -%}
        {%- if block.type == 'text_row' -%}
          #playful-text-{{ block.id }} {
            --playful-rotate: {{ block.settings.rotation_desktop }}deg;
            --playful-rotate-mobile: {{ block.settings.rotation_mobile }}deg;
            --playful-z: {{ block.settings.z_index }};
            --playful-text-max-width: {{ block.settings.text_max_width }}px;
            --playful-text-size: {{ block.settings.font_size_desktop }}px;
            --playful-text-size-mobile: {{ block.settings.font_size_mobile }}px;
            --playful-text-padding-y: {{ block.settings.padding_y }}px;
            --playful-text-color: {{ block.settings.text_color }};
            --playful-scrim-bg: {{ block.settings.scrim_background }};
            --playful-animation-duration: {{ block.settings.animation_duration }}s;
            --playful-animation-delay: {{ block.settings.animation_delay }}s;
          }
          {%- if block.settings.overlap_enabled -%}
            #playful-text-{{ block.id }} {
              --playful-overlap: {{ block.settings.overlap_amount }}px;
              --playful-overlap-mobile: {{ block.settings.overlap_amount_mobile }}px;
            }
          {%- endif -%}
        {%- endif -%}
        {%- if block.type == 'spacer' -%}
          #playful-spacer-{{ block.id }} {
            --playful-spacer-height: {{ block.settings.height }}px;
          }
        {%- endif -%}
      {%- endfor -%}
    {%- endstyle -%}

    <div class="playful-layout">
      <div class="playful-layout__scene playful-layout__scene--{{ layout_mode }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'background' -%}
            <div id="playful-bg-{{ block.id }}" class="playful-layout__bg" {{ block.shopify_attributes }}>
              {%- if block.settings.background_image != blank -%}
                <div class="playful-layout__bg-image {% if block.settings.background_image_mobile != blank %} element--hide-on-small {% endif %}">
                  {%- render 'lazy-image', image: block.settings.background_image, sizes: '100vw', preload: section.index == 1 -%}
                </div>
              {%- endif -%}
              {%- if block.settings.background_image_mobile != blank -%}
                <div class="playful-layout__bg-image element--hide-on-desk">
                  {%- render 'lazy-image', image: block.settings.background_image_mobile, sizes: '100vw', preload: section.index == 1 -%}
                </div>
              {%- elsif block.settings.background_image == blank and block.settings.background_color != 'rgba(0,0,0,0)' -%}
                <div class="playful-layout__bg-image" style="background-color: {{ block.settings.background_color }};"></div>
              {%- endif -%}
              <div class="playful-layout__bg-overlay"></div>
            </div>
          {%- endif -%}
        {%- endfor -%}

        <div class="playful-layout__canvas">
          {%- for block in section.blocks -%}
            {%- if block.type == 'floating_image' -%}
              {%- liquid
                assign float_class = 'playful-layout__float'
                if block.settings.animation != 'none'
                  assign float_class = float_class | append: ' playful-layout__float--anim-' | append: block.settings.animation
                endif
              -%}
              <div id="playful-float-{{ block.id }}" class="{{ float_class }}" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a
                    href="{{ block.settings.link }}"
                    class="playful-layout__float-link"
                    {% if block.settings.link_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                    aria-label="{{ block.settings.link_label | default: 'View link' | escape }}"
                  >
                    {%- if block.settings.image != blank -%}
                      <div class="playful-layout__float-image">
                        {%- render 'lazy-image', image: block.settings.image, sizes: '(max-width: 767px) 40vw, 25vw', class: 'lazy-image--no-transition' -%}
                      </div>
                    {%- endif -%}
                  </a>
                {%- elsif block.settings.image != blank -%}
                  <div class="playful-layout__float-image">
                    {%- render 'lazy-image', image: block.settings.image, sizes: '(max-width: 767px) 40vw, 25vw', class: 'lazy-image--no-transition' -%}
                  </div>
                {%- endif -%}
              </div>
            {%- elsif layout_mode == 'canvas' and block.type == 'text_row' -%}
              {%- liquid
                assign text_class = 'playful-layout__text-row playful-layout__text-row--canvas'
                if block.settings.overlap_enabled
                  assign text_class = text_class | append: ' playful-layout__text-row--overlap'
                endif
                assign text_class = text_class | append: ' playful-layout__text-row--align-' | append: block.settings.text_alignment
                if block.settings.animation != 'none'
                  assign text_class = text_class | append: ' playful-layout__text-row--anim-' | append: block.settings.animation
                endif
                assign inner_class = 'playful-layout__text-inner'
                if block.settings.show_scrim
                  assign inner_class = inner_class | append: ' playful-layout__text-inner--scrim'
                endif
              -%}
              <div id="playful-text-{{ block.id }}" class="{{ text_class }}" {{ block.shopify_attributes }}>
                {%- if block.settings.text != blank -%}
                  <div class="{{ inner_class }} rte">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if layout_mode == 'stacked' -%}
          <div class="playful-layout__stack">
            {%- for block in section.blocks -%}
              {%- if block.type == 'text_row' -%}
                {%- liquid
                  assign text_class = 'playful-layout__text-row playful-layout__text-row--stacked'
                  if block.settings.overlap_enabled
                    assign text_class = text_class | append: ' playful-layout__text-row--overlap'
                  endif
                  assign text_class = text_class | append: ' playful-layout__text-row--align-' | append: block.settings.text_alignment
                  if block.settings.animation != 'none'
                    assign text_class = text_class | append: ' playful-layout__text-row--anim-' | append: block.settings.animation
                  endif
                  assign inner_class = 'playful-layout__text-inner'
                  if block.settings.show_scrim
                    assign inner_class = inner_class | append: ' playful-layout__text-inner--scrim'
                  endif
                -%}
                <div id="playful-text-{{ block.id }}" class="{{ text_class }}" {{ block.shopify_attributes }}>
                  {%- if block.settings.text != blank -%}
                    <div class="{{ inner_class }} rte">{{ block.settings.text }}</div>
                  {%- endif -%}
                </div>
              {%- elsif block.type == 'spacer' -%}
                <div id="playful-spacer-{{ block.id }}" class="playful-layout__spacer" {{ block.shopify_attributes }}></div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

{%- if section.settings.section_background_color != 'rgba(0,0,0,0)' -%}
  {% style %}
    #shopify-section-{{ section.id }} {
      background-color: {{ section.settings.section_background_color }};
    }
  {% endstyle %}
{%- endif -%}
{%- if section.settings.section_background_gradient != blank -%}
  {% style %}
    #shopify-section-{{ section.id }} {
      background: {{ section.settings.section_background_gradient }};
    }
  {% endstyle %}
{%- endif -%}

{% schema %}
{
  "name": "Playful layout",
  "class": "can-be-fullwidth",
  "max_blocks": 16,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout mode",
      "options": [
        { "value": "canvas", "label": "Freeform canvas (positioned elements)" },
        { "value": "stacked", "label": "Stacked (text flows vertically)" }
      ],
      "default": "canvas",
      "info": "Canvas mode positions floating images and text with offset controls. Stacked mode is better for text-heavy rows."
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Scene height (desktop)",
      "options": [
        { "value": "auto", "label": "Auto (content height)" },
        { "value": "3 / 1", "label": "Wide (3:1)" },
        { "value": "5 / 2", "label": "Medium (5:2)" },
        { "value": "2 / 1", "label": "Standard (2:1)" },
        { "value": "16 / 9", "label": "Cinematic (16:9)" },
        { "value": "4 / 3", "label": "Tall (4:3)" },
        { "value": "1 / 1", "label": "Square (1:1)" }
      ],
      "default": "5 / 2"
    },
    {
      "type": "select",
      "id": "aspect_ratio_mobile",
      "label": "Scene height (mobile)",
      "options": [
        { "value": "same", "label": "Same as desktop" },
        { "value": "auto", "label": "Auto (content height)" },
        { "value": "2 / 1", "label": "Standard (2:1)" },
        { "value": "3 / 2", "label": "Tall (3:2)" },
        { "value": "4 / 3", "label": "Extra tall (4:3)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "5 / 2", "label": "Medium (5:2)" },
        { "value": "16 / 9", "label": "Cinematic (16:9)" }
      ],
      "default": "3 / 2"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height (desktop)",
      "min": 0,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 0,
      "info": "0 = use aspect ratio only."
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Minimum height (mobile)",
      "min": 0,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "stack_gap",
      "label": "Stack gap (stacked mode)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "section_padding_y",
      "label": "Vertical padding (stacked mode)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "section_heading_layout",
      "label": "Heading alignment",
      "options": [
        { "value": "section-heading--left", "label": "Left" },
        { "value": "section-heading--center", "label": "Center" }
      ],
      "default": "section-heading--left"
    },
    {
      "type": "header",
      "content": "Section design"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Background color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color_background",
      "id": "section_background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "checkbox",
      "id": "remove_margin",
      "label": "Remove top and bottom spacing",
      "default": true
    },
    {
      "type": "select",
      "id": "seo_h_tag",
      "label": "Heading SEO tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    }
  ],
  "blocks": [
    {
      "type": "background",
      "name": "Background",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "Background image (desktop)"
        },
        {
          "type": "image_picker",
          "id": "background_image_mobile",
          "label": "Background image (mobile, optional)"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Fallback background color",
          "default": "rgba(0,0,0,0)"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Dark overlay",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "default": 0
        }
      ]
    },
    {
      "type": "floating_image",
      "name": "Floating image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label (accessibility)"
        },
        {
          "type": "checkbox",
          "id": "link_new_tab",
          "label": "Open link in new tab",
          "default": false
        },
        {
          "type": "header",
          "content": "Position & size (desktop)"
        },
        {
          "type": "range",
          "id": "horizontal_offset",
          "label": "Horizontal offset",
          "min": -50,
          "max": 50,
          "step": 1,
          "unit": "%",
          "default": 0,
          "info": "From centre of the scene."
        },
        {
          "type": "range",
          "id": "vertical_offset",
          "label": "Vertical offset",
          "min": -50,
          "max": 50,
          "step": 1,
          "unit": "%",
          "default": 0
        },
        {
          "type": "range",
          "id": "size_desktop",
          "label": "Size",
          "min": 10,
          "max": 120,
          "step": 1,
          "unit": "%",
          "default": 35,
          "info": "Width relative to the scene."
        },
        {
          "type": "range",
          "id": "rotation_desktop",
          "label": "Rotation",
          "min": -180,
          "max": 180,
          "step": 1,
          "unit": "°",
          "default": 0
        },
        {
          "type": "header",
          "content": "Position & size (mobile)"
        },
        {
          "type": "range",
          "id": "horizontal_offset_mobile",
          "label": "Horizontal offset",
          "min": -50,
          "max": 50,
          "step": 1,
          "unit": "%",
          "default": 0
        },
        {
          "type": "range",
          "id": "vertical_offset_mobile",
          "label": "Vertical offset",
          "min": -50,
          "max": 50,
          "step": 1,
          "unit": "%",
          "default": 0
        },
        {
          "type": "range",
          "id": "size_mobile",
          "label": "Size",
          "min": 10,
          "max": 120,
          "step": 1,
          "unit": "%",
          "default": 45
        },
        {
          "type": "range",
          "id": "rotation_mobile",
          "label": "Rotation",
          "min": -180,
          "max": 180,
          "step": 1,
          "unit": "°",
          "default": 0
        },
        {
          "type": "header",
          "content": "Layer & animation"
        },
        {
          "type": "range",
          "id": "z_index",
          "label": "Layer (z-index)",
          "min": 1,
          "max": 20,
          "step": 1,
          "default": 3
        },
        {
          "type": "select",
          "id": "animation",
          "label": "Animation",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "float", "label": "Float (gentle bob)" },
            { "value": "wiggle", "label": "Wiggle" },
            { "value": "gentle-spin", "label": "Gentle spin" },
            { "value": "fade-up", "label": "Fade up (entrance)" },
            { "value": "bounce-in", "label": "Bounce in (entrance)" }
          ],
          "default": "none"
        },
        {
          "type": "range",
          "id": "animation_duration",
          "label": "Animation duration",
          "min": 1,
          "max": 12,
          "step": 0.5,
          "unit": "s",
          "default": 4
        },
        {
          "type": "range",
          "id": "animation_delay",
          "label": "Animation delay",
          "min": 0,
          "max": 4,
          "step": 0.1,
          "unit": "s",
          "default": 0
        }
      ]
    },
    {
      "type": "text_row",
      "name": "Text row",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "checkbox",
          "id": "show_scrim",
          "label": "Show text scrim background",
          "default": false
        },
        {
          "type": "color",
          "id": "scrim_background",
          "label": "Scrim background",
          "default": "rgba(255, 255, 255, 0.88)"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#1d1d1d"
        },
        {
          "type": "range",
          "id": "text_max_width",
          "label": "Max text width",
          "min": 280,
          "max": 900,
          "step": 20,
          "unit": "px",
          "default": 560
        },
        {
          "type": "range",
          "id": "font_size_desktop",
          "label": "Font size (desktop)",
          "min": 14,
          "max": 48,
          "step": 1,
          "unit": "px",
          "default": 18
        },
        {
          "type": "range",
          "id": "font_size_mobile",
          "label": "Font size (mobile)",
          "min": 14,
          "max": 36,
          "step": 1,
          "unit": "px",
          "default": 16
        },
        {
          "type": "range",
          "id": "padding_y",
          "label": "Vertical padding",
          "min": 0,
          "max": 80,
          "step": 4,
          "unit": "px",
          "default": 16
        },
        {
          "type": "checkbox",
          "id": "overlap_enabled",
          "label": "Overlap previous block",
          "default": false
        },
        {
          "type": "range",
          "id": "overlap_amount",
          "label": "Overlap amount (desktop)",
          "min": 0,
          "max": 200,
          "step": 4,
          "unit": "px",
          "default": 60
        },
        {
          "type": "range",
          "id": "overlap_amount_mobile",
          "label": "Overlap amount (mobile)",
          "min": 0,
          "max": 120,
          "step": 4,
          "unit": "px",
          "default": 32
        },
        {
          "type": "range",
          "id": "rotation_desktop",
          "label": "Rotation (desktop)",
          "min": -12,
          "max": 12,
          "step": 0.5,
          "unit": "°",
          "default": 0
        },
        {
          "type": "range",
          "id": "rotation_mobile",
          "label": "Rotation (mobile)",
          "min": -12,
          "max": 12,
          "step": 0.5,
          "unit": "°",
          "default": 0
        },
        {
          "type": "range",
          "id": "z_index",
          "label": "Layer (z-index)",
          "min": 1,
          "max": 20,
          "step": 1,
          "default": 4
        },
        {
          "type": "select",
          "id": "animation",
          "label": "Animation",
          "options": [
            { "value": "none", "label": "None" },
