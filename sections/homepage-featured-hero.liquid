{{ 'component-jiggle-graphic.css' | asset_url | stylesheet_tag }}
{{ 'component-collection-canvas.css' | asset_url | stylesheet_tag }}
{{ 'section-homepage-featured-hero.css' | asset_url | stylesheet_tag }}
{{ 'section-homepage-redesign-header.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign featured_collection = section.settings.collection
  capture title_font
    render 'collection-title-font-family'
  endcapture
  assign title_font = title_font | strip
  assign preload = false
  if section.index == 1
    assign preload = true
  endif
-%}

<script>
  (function () {
    document.documentElement.classList.add('redesign-header-overlay');
    document.body.classList.add('redesign-header-overlay');

    function syncHeaderHeight() {
      var header = document.getElementById('site-header');
      if (!header) return;
      var height = header.offsetHeight + 'px';
      document.documentElement.style.setProperty('--site-header-height', height);
      document.documentElement.style.setProperty('--header-height', height);
    }

    syncHeaderHeight();
    window.addEventListener('resize', syncHeaderHeight);
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(syncHeaderHeight);
    }
  })();
</script>

{%- if featured_collection != blank -%}
  {%- style -%}
    #shopify-section-{{ section.id }} .homepage-featured-hero__inner {
      --featured-hero-height: {{ section.settings.hero_height_desktop }}vh;
      --featured-hero-height-mobile: {{ section.settings.hero_height_mobile }}vh;
      --collection-title-font: {{ title_font | json }};
      --hero-strapline-gap: {{ section.settings.hero_strapline_gap }}rem;
      --hero-title-size: {{ section.settings.hero_title_size }}rem;
      --hero-strapline-size: {{ section.settings.hero_strapline_size }}rem;
    }
    @media screen and (max-width: 767px) {
      #shopify-section-{{ section.id }} .homepage-featured-hero__inner {
        --hero-title-size: {{ section.settings.hero_title_size_mobile }}rem;
        --hero-strapline-size: {{ section.settings.hero_strapline_size_mobile }}rem;
      }
      #collection-canvas-{{ section.id }} .collection-canvas__text-block {
        --layer-rotate: {{ section.settings.hero_text_rotation_mobile | default: section.settings.hero_text_rotation }}deg;
      }
      #collection-canvas-{{ section.id }} .collection-canvas__title {
        --title-rotate: {{ section.settings.hero_title_rotation_mobile | default: section.settings.hero_title_rotation }}deg;
      }
      #collection-canvas-{{ section.id }} .collection-canvas__strapline {
        --strapline-rotate: {{ section.settings.hero_strapline_rotation_mobile | default: section.settings.hero_strapline_rotation }}deg;
      }
    }
  {%- endstyle -%}

  {%- assign canvas_id = 'collection-canvas-' | append: section.id -%}
  <div class="homepage-featured-hero container--fullwidth remove-empty-space">
    <div class="homepage-featured-hero__inner">
      {%- render 'collection-hero-canvas',
        collection: featured_collection,
        variant: 'hero',
        canvas_id: canvas_id,
        title_font: title_font,
        preload: preload,
        prefer_image_overrides: false,
        overlay_columns_layout: true,
        shared_overlay_image: section.settings.feature_image,
        overlay_1_ox: section.settings.feature_1_offset_x,
        overlay_1_oy: section.settings.feature_1_offset_y,
        overlay_1_rot: section.settings.feature_1_rotation,
        overlay_1_scale: section.settings.feature_1_scale,
        overlay_1_flip: section.settings.feature_1_flip_horizontal,
        overlay_2_ox: section.settings.feature_2_offset_x,
        overlay_2_oy: section.settings.feature_2_offset_y,
        overlay_2_rot: section.settings.feature_2_rotation,
        overlay_2_scale: section.settings.feature_2_scale,
        overlay_2_flip: section.settings.feature_2_flip_horizontal,
        overlay_3_ox: section.settings.feature_3_offset_x,
        overlay_3_oy: section.settings.feature_3_offset_y,
        overlay_3_rot: section.settings.feature_3_rotation,
        overlay_3_scale: section.settings.feature_3_scale,
        overlay_3_flip: section.settings.feature_3_flip_horizontal,
        override_hero_background: section.settings.hero_background,
        override_hero_title: section.settings.override_title,
        override_hero_strapline: section.settings.override_strapline,
        override_hero_text_offset_x: section.settings.hero_text_offset_x,
        override_hero_text_offset_y: section.settings.hero_text_offset_y,
        override_hero_text_rotation: section.settings.hero_text_rotation,
        override_hero_text_rotation_mobile: section.settings.hero_text_rotation_mobile,
        override_hero_strapline_gap: section.settings.hero_strapline_gap,
        override_hero_strapline_rotation: section.settings.hero_strapline_rotation,
        override_hero_strapline_rotation_mobile: section.settings.hero_strapline_rotation_mobile,
        override_hero_title_offset_x: section.settings.hero_title_offset_x,
        override_hero_title_offset_y: section.settings.hero_title_offset_y,
        override_hero_title_rotation: section.settings.hero_title_rotation,
        override_hero_title_rotation_mobile: section.settings.hero_title_rotation_mobile
      -%}
    </div>
  </div>
{%- endif -%}

