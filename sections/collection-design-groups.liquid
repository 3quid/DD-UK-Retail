{{ 'section-collection-design-groups.css' | asset_url | stylesheet_tag }}

{%- unless section.settings.enabled -%}
  {%- comment -%} Scaffold: enable in theme editor when design_name filter is live. {%- endcomment -%}
{%- else -%}
  {%- liquid
    assign filter_key = section.settings.filter_key | default: 'design_name' | downcase
    assign groups_filter = nil
    assign active_group_value = nil

    for filter in collection.filters
      assign param_downcase = filter.param_name | downcase
      assign label_downcase = filter.label | downcase
      if param_downcase contains filter_key or label_downcase contains filter_key
        assign groups_filter = filter
        break
      endif
    endfor

    if groups_filter != nil
      for value in groups_filter.active_values
        assign active_group_value = value.label
        break
      endfor
    endif

    assign qualifying_group_count = 0
    if groups_filter != nil
      for value in groups_filter.values
        if value.count > 1
          assign qualifying_group_count = qualifying_group_count | plus: 1
        endif
      endfor
    endif
  -%}

  {%- if groups_filter != nil and qualifying_group_count > 0 and active_group_value == blank -%}
    {%- liquid
      assign sorted_group_values = groups_filter.values | sort: 'count' | reverse
      assign collapsible_mobile = false
      assign collapsible_desktop = false
      if qualifying_group_count > 4
        assign collapsible_mobile = true
      endif
      if qualifying_group_count > 6
        assign collapsible_desktop = true
      endif

      assign has_toggle = false
      if collapsible_mobile or collapsible_desktop
        assign has_toggle = true
      endif

      assign show_title = false
      if section.settings.show_heading and section.settings.heading != blank
        assign show_title = true
      endif
    -%}
    <div
      id="section-{{ section.id }}"
      class="container--large{% unless section.settings.remove_margin %} container--vertical-space{% endunless %}"
    >
      <div
        class="collection-design-groups{% if collapsible_mobile %} is-collapsible-mobile{% endif %}{% if collapsible_desktop %} is-collapsible-desktop{% endif %}"
      >
      {%- if show_title or has_toggle -%}
        <div class="collection-design-groups__header gutter-bottom--regular">
          <div class="collection-design-groups__title-row">
            {%- if show_title -%}
              <h2 class="h4 collection-design-groups__heading">{{ section.settings.heading | escape }}</h2>
            {%- endif -%}

            {%- if has_toggle -%}
              <button
                type="button"
                class="collection-design-groups__toggle link underlined-link"
                aria-expanded="false"
              >
                <span class="collection-design-groups__toggle-label collection-design-groups__toggle-label--more">See all groups</span>
                <span class="collection-design-groups__toggle-label collection-design-groups__toggle-label--less">Show fewer groups</span>
              </button>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <div class="collection-design-groups__grid" role="list">
        {%- paginate collection.products by 250 -%}
          {%- for value in sorted_group_values -%}
            {%- if value.count > 1 -%}
              {%- liquid
                assign value_label = value.label | strip
                assign show_m = false
                assign show_w = false
                assign show_mx = false
                assign show_k = false
                assign show_kx = false

                for product in collection.products
                  assign product_design = product.metafields.custom.design_name | default: product.title | strip
                  if product_design == value_label
                    assign handle_downcase = product.handle | downcase
                    if handle_downcase contains 'kids-xl-'
                      assign show_kx = true
                    elsif handle_downcase contains 'kids-'
                      assign show_k = true
                    elsif handle_downcase contains 'womens-' or handle_downcase contains 'women-'
                      assign show_w = true
                    elsif handle_downcase contains 'mens-xl-'
                      assign show_mx = true
                    elsif handle_downcase contains 'mens-' or handle_downcase contains 'men-'
                      assign show_m = true
                    endif
                  endif
                endfor
              -%}

              <a
                href="{{ value.url_to_add | escape }}"
                class="collection-design-groups__card{% if value.active %} collection-design-groups__card--active{% endif %}"
                role="listitem"
              >
                <span class="collection-design-groups__label">{{ value.label | escape }}</span>

                <div class="collection-design-groups__footer">
                  <span class="collection-design-groups__badges" aria-hidden="true">
                    {%- if show_m -%}
                      <span class="collection-design-groups__badge collection-design-groups__badge--m" title="Men's">M</span>
                    {%- endif -%}
                    {%- if show_w -%}
                      <span class="collection-design-groups__badge collection-design-groups__badge--w" title="Women's">W</span>
                    {%- endif -%}
                    {%- if show_mx -%}
                      <span class="collection-design-groups__badge collection-design-groups__badge--m-plus" title="Men's XL">M+</span>
                    {%- endif -%}
                    {%- if show_k -%}
                      <span class="collection-design-groups__badge collection-design-groups__badge--k" title="Kids">K</span>
                    {%- endif -%}
                    {%- if show_kx -%}
                      <span class="collection-design-groups__badge collection-design-groups__badge--k-plus" title="Kids XL">K+</span>
                    {%- endif -%}
                  </span>

                  <span class="collection-design-groups__count">
                    {%- if value.count == 1 -%}
                      1 style
                    {%- else -%}
                      {{ value.count }} styles
                    {%- endif -%}
                  </span>
                </div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        {%- endpaginate -%}
      </div>
      </div>
    </div>
    <script src="{{ 'section-collection-design-groups.js' | asset_url }}" defer></script>
  {%- endif -%}
{%- endunless -%}

{% schema %}
{
  "name": "26 Coll design groups",
  "class": "collection-design-groups-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Renders browse groups from a Search & Discovery product filter (e.g. custom.design_name). Only shows designs with 2+ styles, sorted by style count. Shows 6 on desktop / 4 on mobile with See all groups to expand."
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show design groups",
      "default": true
    },
    {
      "type": "text",
      "id": "filter_key",
      "label": "Filter key",
      "default": "design_name",
      "info": "Matches filter param or label containing this text (case insensitive)."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Browse by design"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "remove_margin",
      "label": "Remove section margin",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "26 Coll design groups"
    }
  ]
}
{% endschema %}
