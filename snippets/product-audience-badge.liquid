{%- comment -%}
  Echoes audience badge code from product handle: M, W, M+, K, K+.

  Accepts:
  - product: {Object} product
  - handle: {String} optional handle override
{%- endcomment -%}
{%- liquid
  assign handle_downcase = handle | default: product.handle | downcase
  assign audience_badge = ''

  if handle_downcase contains 'kids-xl-'
    assign audience_badge = 'K+'
  elsif handle_downcase contains 'kids-'
    assign audience_badge = 'K'
  elsif handle_downcase contains 'womens-' or handle_downcase contains 'women-'
    assign audience_badge = 'W'
  elsif handle_downcase contains 'mens-xl-'
    assign audience_badge = 'M+'
  elsif handle_downcase contains 'mens-' or handle_downcase contains 'men-'
    assign audience_badge = 'M'
  endif
-%}{{- audience_badge -}}
