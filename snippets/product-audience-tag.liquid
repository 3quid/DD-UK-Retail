{%- comment -%}
  Audience pill from product handle (fallback: tags). Colours match design-group badges.

  Accepts:
  - product: {Object} product
{%- endcomment -%}
{%- liquid
  assign handle_downcase = product.handle | downcase
  assign label = ''
  assign modifier = ''

  if handle_downcase contains 'kids-xl-'
    assign label = 'Kids XL'
    assign modifier = 'tag-audience--k-plus'
  elsif handle_downcase contains 'kids-'
    assign label = 'Kids'
    assign modifier = 'tag-audience--k'
  elsif handle_downcase contains 'womens-' or handle_downcase contains 'women-'
    assign label = 'Womens'
    assign modifier = 'tag-audience--w'
  elsif handle_downcase contains 'mens-xl-'
    assign label = 'Mens XL'
    assign modifier = 'tag-audience--m-plus'
  elsif handle_downcase contains 'mens-' or handle_downcase contains 'men-'
    assign label = 'Mens'
    assign modifier = 'tag-audience--m'
  endif

  if label == blank
    if product.tags contains 'womens'
      assign label = 'Womens'
      assign modifier = 'tag-audience--w'
    elsif product.tags contains 'mens'
      assign label = 'Mens'
      assign modifier = 'tag-audience--m'
    elsif product.tags contains 'kids'
      assign label = 'Kids'
      assign modifier = 'tag-audience--k'
    endif
  endif
-%}
{%- if label != blank -%}
  <li class="tag-audience {{ modifier }}">{{ label }}</li>
{%- endif -%}
